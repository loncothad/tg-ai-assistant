TELEFORGE_PUBLIC_URL=https://bot-admin.example.com
TELEFORGE_DATABASE_PATH=data/teleforge.redb
# Generate once with: openssl rand -base64 32
TELEFORGE_MASTER_KEY=

# Comma-separated, in the order of enabled `bots` entries in config.yaml.
TELEGRAM_BOT_TOKENS=123456:token-one,789012:token-two

# Optional bootstrap keys. They are encrypted into each bot's isolated state.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://example.com
AIHUB_API_KEY=
AIHUB_BASE_URL=https://aihub.top/v1
FAL_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

RUST_LOG=teleforge=info,tower_http=info
TOKIO_WORKER_THREADS=2
