[Unit]
Description=Teleforge Telegram AI assistant
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=teleforge
Group=teleforge
WorkingDirectory=/var/lib/teleforge
EnvironmentFile=/etc/teleforge/teleforge.env
ExecStart=/usr/local/bin/teleforge --config /etc/teleforge/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
KillSignal=SIGTERM
UMask=0077
MemoryAccounting=true
TasksAccounting=true
TasksMax=128
LimitNOFILE=16384
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/teleforge

[Install]
WantedBy=multi-user.target
