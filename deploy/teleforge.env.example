# Install as /etc/teleforge/teleforge.env with mode 0600.
TELEGRAM_BOT_TOKENS=123456:replace_me
TELEFORGE_PUBLIC_URL=https://bot.example.com
TELEFORGE_LISTEN=127.0.0.1:8080
TELEFORGE_DATABASE_PATH=/var/lib/teleforge/teleforge.redb
TELEFORGE_MASTER_KEY=replace_with_output_of_openssl_rand_base64_32
OPENROUTER_API_KEY=
AIHUB_API_KEY=
FAL_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
RUST_LOG=teleforge=info,tower_http=warn
# This workload is network-bound; two runtime workers avoid whole-machine CPU bursts.
TOKIO_WORKER_THREADS=2
